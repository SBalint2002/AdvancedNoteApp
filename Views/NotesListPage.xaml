<?xml version="1.0" encoding="utf-8" ?>
<ContentPage 
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:viewmodels="clr-namespace:AdvancedNoteApp.ViewModels"
    xmlns:models="clr-namespace:AdvancedNoteApp.Models"
    x:DataType="viewmodels:NotesListViewModel"
    x:Class="AdvancedNoteApp.Views.NotesListPage"
    x:Name="NotesPageRoot"
    BackgroundColor="{AppThemeBinding Light=#FAFAFA, Dark=#1C1C1E}">

    <ContentPage.ToolbarItems>
        <ToolbarItem Text="{Binding SelectionToggleText}" Command="{Binding ToggleSelectionModeCommand}" />
        <ToolbarItem Text="Törlés" Command="{Binding DeleteSelectedCommand}" IsEnabled="{Binding HasSelectedItems}" />
    </ContentPage.ToolbarItems>

    <Grid Padding="16" RowDefinitions="Auto,*">
        <Grid ColumnDefinitions="*" Padding="0,6" Row="0">
            <Label Text="Jegyzetek"
                   FontAttributes="Bold"
                   FontSize="28"
                   VerticalOptions="Center"
                   TextColor="{AppThemeBinding Light=Black, Dark=White}" />
        </Grid>

        <CollectionView x:Name="NotesCollectionView"
                        Grid.Row="1"
                        ItemsSource="{Binding Notes}"
                        SelectionMode="None"
                        BackgroundColor="Transparent"
                        Margin="0">

            <CollectionView.ItemsLayout>
                <LinearItemsLayout Orientation="Vertical" ItemSpacing="12" />
            </CollectionView.ItemsLayout>

            <CollectionView.EmptyView>
                <Label Text="Nincsenek jegyzetek még…" 
                       FontAttributes="Italic"
                       HorizontalOptions="Center"
                       VerticalOptions="Center"
                       TextColor="Gray" />
            </CollectionView.EmptyView>

            <CollectionView.ItemTemplate>
                <DataTemplate x:DataType="models:Note">
                    <Border Margin="0"
                            Stroke="{AppThemeBinding Light=#E0E0E0, Dark=#2C2C2E}"
                            StrokeShape="RoundRectangle 12"
                            BackgroundColor="{AppThemeBinding Light=#FFFFFF, Dark=#2C2C2E}">

                        <Border.Triggers>
                            <DataTrigger TargetType="Border" Binding="{Binding IsSelected}" Value="True">
                                <Setter Property="BackgroundColor" Value="#E8F0FF" />
                                <Setter Property="Stroke" Value="#007AFF" />
                            </DataTrigger>
                        </Border.Triggers>

                        <Border.GestureRecognizers>
                            <TapGestureRecognizer Command="{Binding Source={x:Reference NotesPageRoot}, Path=BindingContext.TapItemCommand}"
                                                  CommandParameter="{Binding .}"
                                                  NumberOfTapsRequired="1" />
                        </Border.GestureRecognizers>

                        <Border.Shadow>
                            <Shadow Brush="#33000000" Offset="0,2" Radius="6" />
                        </Border.Shadow>

                        <Grid Padding="14,10" ColumnDefinitions="Auto, *, Auto" RowDefinitions="Auto">
                            <CheckBox Grid.Column="0"
                                      IsVisible="{Binding BindingContext.IsSelectionMode, Source={x:Reference NotesPageRoot}}"
                                      IsChecked="{Binding IsSelected, Mode=TwoWay}"
                                      VerticalOptions="Center"
                                      Margin="0,0,8,0"/>

                            <VerticalStackLayout Grid.Column="1" Padding="0">
                                <Label Text="{Binding Title}" 
                                       FontAttributes="Bold" 
                                       FontSize="18"
                                       TextColor="{AppThemeBinding Light=Black, Dark=White}" />
                                <Label Text="{Binding Content}" 
                                       FontSize="14"
                                       LineBreakMode="TailTruncation"
                                       MaxLines="1"
                                       TextColor="Gray" />
                            </VerticalStackLayout>

                            <VerticalStackLayout Grid.Column="2"
                                                 HorizontalOptions="End"
                                                 VerticalOptions="Center"
                                                 Spacing="2"
                                                 Padding="6,0,6,0"
                                                 WidthRequest="110">
                                <Label Text="{Binding UpdatedAt, StringFormat='{}{0:yyyy.MM.dd H:mm}'}"
                                       FontSize="12"
                                       TextColor="Gray"
                                       HorizontalTextAlignment="End"
                                       LineBreakMode="TailTruncation"
                                       MaxLines="1" />

                                <Label Text=""
                                       FontSize="16"
                                       HorizontalTextAlignment="End"
                                       AutomationId="SyncStatusLabel">
                                    <Label.Triggers>
                                        <DataTrigger TargetType="Label" Binding="{Binding Synced}" Value="True">
                                            <Setter Property="Text" Value="✔" />
                                            <Setter Property="TextColor" Value="#28A745" />
                                        </DataTrigger>
                                    </Label.Triggers>
                                </Label>
                            </VerticalStackLayout>
                        </Grid>
                    </Border>
                </DataTemplate>
            </CollectionView.ItemTemplate>
        </CollectionView>


        <Border Grid.RowSpan="2"
                HorizontalOptions="End"
                VerticalOptions="End"
                StrokeShape="RoundRectangle 30"
                BackgroundColor="{AppThemeBinding Light=#007AFF, Dark=#0A84FF}"
                WidthRequest="64"
                HeightRequest="64"
                Padding="0"
                Margin="0,0,8,8"
                Shadow="0,2,6,#33000000"
                IsVisible="True">

            <Button Text="＋"
                    Command="{Binding AddNewNoteCommand}"
                    BackgroundColor="Transparent"
                    TextColor="White"
                    FontSize="30"
                    WidthRequest="64"
                    HeightRequest="64"
                    HorizontalOptions="Center"
                    VerticalOptions="Center"
                    SemanticProperties.Hint="Create new note"
                    AutomationId="AddNoteButton"/>
        </Border>
    </Grid>
</ContentPage>