<?xml version="1.0" encoding="utf-8" ?>
<ContentPage 
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:viewmodels="clr-namespace:AdvancedNoteApp.ViewModels"
    x:DataType="viewmodels:NoteDetailViewModel"
    x:Class="AdvancedNoteApp.Views.NoteDetailPage"
    BackgroundColor="{AppThemeBinding Light=#FAFAFA, Dark=#1C1C1E}"
    NavigationPage.HasNavigationBar="False">

    <Grid RowDefinitions="Auto,*,Auto">

        <Grid Grid.Row="0"
              Padding="12,8"
              BackgroundColor="{AppThemeBinding Light=#F9F9F9, Dark=#2C2C2E}"
              ColumnDefinitions="Auto,*,Auto"
              HeightRequest="56">

            <Label Text="Vissza"
                   FontSize="16"
                   VerticalOptions="Center"
                   Padding="6,4">
                <Label.GestureRecognizers>
                    <TapGestureRecognizer Tapped="OnBackTapped"/>
                </Label.GestureRecognizers>
            </Label>
        </Grid>

        <ScrollView Grid.Row="1" VerticalOptions="FillAndExpand">
            <VerticalStackLayout Padding="20" Spacing="16">
                <Entry Placeholder="Cím"
                       FontSize="26"
                       FontAttributes="Bold"
                       Text="{Binding Note.Title}"
                       TextColor="{AppThemeBinding Light=Black, Dark=White}"
                       BackgroundColor="Transparent"
                       PlaceholderColor="{AppThemeBinding Light=#A0A0A0, Dark=#888}" />

                <Image Source="{Binding Note.ImageUrl}"
                       Aspect="AspectFill"
                       HeightRequest="240"
                       IsVisible="{Binding HasImage}" />

                <Editor Placeholder="Írd ide a jegyzetet..."
                        Text="{Binding Note.Content}"
                        FontSize="16"
                        TextColor="{AppThemeBinding Light=Black, Dark=White}"
                        BackgroundColor="Transparent"
                        AutoSize="TextChanges"
                        VerticalOptions="FillAndExpand" />
            </VerticalStackLayout>
        </ScrollView>


        <Border Grid.RowSpan="3"
                HorizontalOptions="End"
                VerticalOptions="End"
                WidthRequest="64"
                HeightRequest="64"
                StrokeShape="RoundRectangle 32"
                BackgroundColor="{AppThemeBinding Light=#007AFF, Dark=#0A84FF}"
                Margin="0,0,20,20"
                Shadow="0,3,8,#55000000"
                ZIndex="10">
            <Button Text="📷"
                Command="{Binding CaptureImageCommand}"
                BackgroundColor="Transparent"
                TextColor="White"
                FontSize="28"
                WidthRequest="64"
                HeightRequest="64"
                HorizontalOptions="Center"
                VerticalOptions="Center"
                CornerRadius="32" />
        </Border>

        <Border Grid.RowSpan="3"
                HorizontalOptions="End"
                VerticalOptions="End"
                WidthRequest="56"
                HeightRequest="56"
                StrokeShape="RoundRectangle 28"
                BackgroundColor="{AppThemeBinding Light=#FF3B30, Dark=#FF453A}"
                Margin="0,0,20,96"
                Shadow="0,3,8,#55000000"
                IsVisible="{Binding HasImage}"
                ZIndex="10">
            <Button Text="🗑"
                    Command="{Binding RemoveImageCommand}"
                    BackgroundColor="Transparent"
                    TextColor="White"
                    FontSize="22"
                    WidthRequest="56"
                    HeightRequest="56"
                    HorizontalOptions="Center"
                    VerticalOptions="Center"
                    CornerRadius="28" />
        </Border>


    </Grid>
</ContentPage>
