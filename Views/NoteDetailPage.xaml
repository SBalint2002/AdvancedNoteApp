<?xml version="1.0" encoding="utf-8" ?>
<ContentPage 
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:viewmodels="clr-namespace:AdvancedNoteApp.ViewModels"
    x:DataType="viewmodels:NoteDetailViewModel"
    x:Class="AdvancedNoteApp.Views.NoteDetailPage"
    BackgroundColor="{AppThemeBinding Light=#FAFAFA, Dark=#1C1C1E}"
    NavigationPage.HasNavigationBar="False">

    <Grid RowDefinitions="Auto,*,Auto">

        <Grid Padding="15,10" 
              BackgroundColor="{AppThemeBinding Light=#F9F9F9, Dark=#2C2C2E}" 
              ColumnDefinitions="Auto,*,Auto"
              HeightRequest="56">

            <Button Text="Vissza"
                    BackgroundColor="Transparent"
                    TextColor="{AppThemeBinding Light=#007AFF, Dark=#0A84FF}"
                    Clicked="OnBackTapped"
                    Grid.Column="0"
                    VerticalOptions="Center"
                    Padding="12,0"
                    HeightRequest="36">
                <Button.Triggers>
                    <Trigger TargetType="Button" Property="IsPressed" Value="True">
                        <Setter Property="Opacity" Value="0.4"/>
                    </Trigger>
                </Button.Triggers>
            </Button>
            <Label Grid.Column="1"
                   Text="Jegyzet"
                   FontSize="18"
                   FontAttributes="Bold"
                   HorizontalOptions="Center"
                   VerticalOptions="Center"/>
        </Grid>

        <ScrollView Grid.Row="1"
                    VerticalOptions="Fill"
                    BackgroundColor="Transparent"
                    Margin="0"
                    Padding="0">
            <VerticalStackLayout Padding="20" Spacing="15" VerticalOptions="Start">
                <Entry Placeholder="Cím"
                       FontSize="24"
                       FontAttributes="Bold"
                       Text="{Binding Note.Title}"
                       TextColor="{AppThemeBinding Light=Black, Dark=White}"
                       BackgroundColor="Transparent" />

                <Editor Placeholder="Írd ide a jegyzetet..."
                        Text="{Binding Note.Content}"
                        FontSize="16"
                        TextColor="{AppThemeBinding Light=Black, Dark=White}"
                        BackgroundColor="Transparent"
                        AutoSize="TextChanges"
                        HeightRequest="120" />

                <Image Source="{Binding Note.ImageUrl}"
                       Aspect="AspectFill"
                       HeightRequest="240"
                       IsVisible="{Binding HasImage}" />
            </VerticalStackLayout>
        </ScrollView>

        <Grid Grid.Row="2" Padding="16" BackgroundColor="{AppThemeBinding Light=#F9F9F9, Dark=#2C2C2E}" ColumnDefinitions="*,*">
            <Button Text="Kép készítése"
                    Command="{Binding CaptureImageCommand}"
                    BackgroundColor="{AppThemeBinding Light=#007AFF, Dark=#0A84FF}"
                    TextColor="White"
                    Grid.Column="0"
                    Margin="0,0,8,0" />

            <Button Text="Kép törlése"
                    Command="{Binding RemoveImageCommand}"
                    BackgroundColor="{AppThemeBinding Light=#FF3B30, Dark=#FF453A}"
                    TextColor="White"
                    Grid.Column="1"
                    IsVisible="{Binding HasImage}" />
        </Grid>
    </Grid>
</ContentPage>
